# Database
# For local development with docker-compose:
DATABASE_URL="postgresql://chunker:chunker_password@localhost:5432/episode_chunker?schema=public"

# For production, use your cloud provider's connection string:
# DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# OpenAI (optional - for LLM-based segmentation)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Segmentation defaults
DEFAULT_SEGMENTATION_MODE=heuristic  # heuristic or llm
MAX_CHUNK_LENGTH=1000
MIN_EPISODE_CHUNKS=3
MAX_EPISODE_CHUNKS=50
